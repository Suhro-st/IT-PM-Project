        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    Pengguna {\n        int id_pengguna PK\n        string nim_nip\n        string nama_lengkap\n        string email\n        string kata_sandi\n        string no_hp\n        enum peran\n        string foto_profil\n        datetime dibuat_pada\n    }\n\n    Staf {\n        int id_staf PK\n        int id_pengguna FK\n        string bidang_keahlian\n        text deskripsi_profil\n        enum status_ketersediaan\n        decimal rating_rata\n    }\n\n    Kategori {\n        int id_kategori PK\n        string nama_kategori\n        text keterangan\n    }\n\n    Jasa {\n        int id_jasa PK\n        int id_staf FK\n        int id_kategori FK\n        string nama_jasa\n        text deskripsi\n        decimal harga\n        string satuan\n        enum status\n        datetime dibuat_pada\n    }\n\n    Pesanan {\n        int id_pesanan PK\n        int id_pemesan FK\n        int id_staf FK\n        int id_jasa FK\n        text rincian\n        datetime tgl_pesan\n        datetime tgl_kerja\n        enum status\n        decimal total_biaya\n    }\n\n    Pembayaran {\n        int id_pembayaran PK\n        int id_pesanan FK\n        decimal jumlah\n        string metode\n        string bukti\n        enum status\n        datetime dibayar_pada\n    }\n\n    Penilaian {\n        int id_nilai PK\n        int id_pesanan FK\n        int bintang\n        text ulasan\n        datetime dibuat_pada\n    }\n\n    AdminLog {\n        int id_log PK\n        int id_admin FK\n        string aktivitas\n        datetime waktu\n    }\n\n    Pengguna ||--o| Staf : \&quot;berperan sebagai\&quot;\n    Pengguna ||--o{ AdminLog : \&quot;melakukan\&quot;\n    Pengguna ||--o{ Pesanan : \&quot;memesan\&quot;\n    Staf ||--o{ Jasa : \&quot;menyediakan\&quot;\n    Staf ||--o{ Pesanan : \&quot;mengerjakan\&quot;\n    Kategori ||--o{ Jasa : \&quot;mengelompokkan\&quot;\n    Jasa ||--o{ Pesanan : \&quot;dipesan\&quot;\n